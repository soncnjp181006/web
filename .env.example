# VulnShop environment template - set real values in the Render dashboard
# (NEVER commit real credentials to git).

# Render injects DATABASE_URL / REDIS_URL automatically via render.yaml
# DATABASE_URL=postgres://...
# REDIS_URL=rediss://...

SUPERTOKENS_CONNECTION_URI=http://vulnshop-st:3563
INTERNAL_PORT=4000

# Supertokens appInfo (set after Cloudflare Pages gives you the URL)
API_DOMAIN=https://vulnshop.pages.dev
WEBSITE_DOMAIN=https://vulnshop.pages.dev

# Gmail SMTP (app password) - value from chat, set in Render dashboard only
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password

# Lab secrets (weak defaults are intentional; override only if you want)
# JWT_SECRET=jwt-secret-123
# ADMIN_TOKEN=admin-token-123
# ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
